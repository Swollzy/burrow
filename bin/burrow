#!/bin/bash
# Burrow: run Windows programs and Windows Steam on a Mac, CrossOver style, on top of
# Wine (LGPL) and DXMT. Burrow downloads those from their own projects at setup time
# and never bundles them.
#
# Written for the bash 3.2 that ships with macOS: no associative arrays, no ${x,,},
# no mapfile. Run `burrow help` for the commands.
set -u

BURROW_VERSION="0.3.0"

# --- Paths and pinned downloads -------------------------------------------------------
BURROW_HOME="${BURROW_HOME:-$HOME/Library/Application Support/Burrow}"
ENGINES="$BURROW_HOME/engines"
RUNTIMES="$BURROW_HOME/runtimes"
BOTTLES="$BURROW_HOME/bottles"
LIBRARY="$BURROW_HOME/library"
LOGS="$BURROW_HOME/logs"
CACHE="$BURROW_HOME/cache"
SNAPSHOTS="$BURROW_HOME/snapshots"
SHORTCUTS="${BURROW_SHORTCUTS:-$HOME/Applications/Burrow}"
here="$(cd "$(dirname "$0")" && pwd)"
APPDIR="$(cd "$here/.." && pwd)"

# Wine 11.18 is the version the turbo patches were tested against (Neutron, 2026-10).
WINE_VERSION="${BURROW_WINE_VERSION:-11.18}"
WINE_URL="${BURROW_WINE_URL:-https://github.com/Gcenx/macOS_Wine_builds/releases/download/$WINE_VERSION/wine-devel-$WINE_VERSION-osx64.tar.xz}"
WINE_RELEASE_API="https://api.github.com/repos/Gcenx/macOS_Wine_builds/releases/tags/$WINE_VERSION"
# DXMT v0.80 is the last MIT-licensed release (later ones are LGPL, which is fine too).
DXMT_VERSION="${BURROW_DXMT_VERSION:-v0.80}"
DXMT_URL="${BURROW_DXMT_URL:-https://github.com/3Shain/dxmt/releases/download/$DXMT_VERSION/dxmt-$DXMT_VERSION-builtin.tar.gz}"
DXMT_RELEASE_API="https://api.github.com/repos/3Shain/dxmt/releases/tags/$DXMT_VERSION"
STEAM_SETUP_URL="${BURROW_STEAM_URL:-https://cdn.cloudflare.steamstatic.com/client/installer/SteamSetup.exe}"
STEAM_BOTTLE="Steam"
STEAM_DIR_WIN='C:\Program Files (x86)\Steam'
STEAM_REL="drive_c/Program Files (x86)/Steam"
WRAPPER_MARKER="BURROW-WEBHELPER-WRAPPER-1"

STOCK_ENGINE="wine-$WINE_VERSION"
TURBO_ENGINE="wine-$WINE_VERSION-turbo"

# --- Output -----------------------------------------------------------------------------
if [ -t 1 ]; then B=$'\033[1m'; D=$'\033[2m'; R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; N=$'\033[0m'
else B=""; D=""; R=""; G=""; Y=""; N=""; fi
say()  { printf '%s\n' "$*"; }
step() { printf '%s==>%s %s\n' "$B" "$N" "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

is_mac() { [ "$(uname -s)" = "Darwin" ]; }
cpu_count() { sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4; }

# APFS clone on a Mac (nearly free), plain copy elsewhere.
clone_tree() { if is_mac; then cp -c -R "$1" "$2" 2>/dev/null || cp -R "$1" "$2"; else cp -R "$1" "$2"; fi; }

# Turns any text into a safe file name: "Schedule I" -> "schedule-i".
slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//'
}

# key=value files. Values are stored raw, one per line; read back with conf_get.
conf_get() { # file key
  [ -f "$1" ] || return 1
  local line
  line=$(grep -m1 "^$2=" "$1") || return 1
  printf '%s' "${line#*=}"
}
conf_set() { # file key value
  local tmp="$1.tmp.$$"
  { [ -f "$1" ] && grep -v "^$2=" "$1"; printf '%s=%s\n' "$2" "$3"; } > "$tmp" && mv "$tmp" "$1"
}

download() { # url dest
  local tmp="$2.part"
  mkdir -p "$(dirname "$2")"
  say "${D}  $1${N}"
  curl -fL --retry 3 --retry-delay 2 --progress-bar -o "$tmp" "$1" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$2"
}

# Asks GitHub for a release's asset URL matching a pattern, for when a pinned name moved.
release_asset() { # api-url grep-pattern
  curl -fsSL "$1" 2>/dev/null | grep -o '"browser_download_url": *"[^"]*"' | sed 's/.*"\(http[^"]*\)"$/\1/' | grep -E "$2" | head -1
}

# --- Engines (Wine builds) ----------------------------------------------------------------
# BURROW_WINE points at any wine binary instead (used by the tests on Linux).
engine_root() { printf '%s/%s' "$ENGINES" "$1"; }
engine_wine() { # engine -> path of its wine binary
  if [ -n "${BURROW_WINE:-}" ] && [ "$1" = "$STOCK_ENGINE" ]; then printf '%s' "$BURROW_WINE"; return; fi
  local root; root=$(engine_root "$1")
  if [ -x "$root/bin/wine" ]; then printf '%s' "$root/bin/wine"
  elif [ -x "$root/bin/wine64" ]; then printf '%s' "$root/bin/wine64"
  else return 1; fi
}
engine_wineserver() {
  if [ -n "${BURROW_WINESERVER:-}" ]; then printf '%s' "$BURROW_WINESERVER"; return; fi
  if [ -n "${BURROW_WINE:-}" ] && [ "$1" = "$STOCK_ENGINE" ]; then
    local d; d=$(dirname "$BURROW_WINE")
    if [ -x "$d/wineserver" ]; then printf '%s' "$d/wineserver"; else command -v wineserver; fi
    return
  fi
  printf '%s/bin/wineserver' "$(engine_root "$1")"
}
engine_ok() { engine_wine "$1" >/dev/null 2>&1; }
best_engine() { if engine_ok "$TURBO_ENGINE"; then echo "$TURBO_ENGINE"; else echo "$STOCK_ENGINE"; fi; }

# --- Settings ------------------------------------------------------------------------------------
# Every setting has a scope: "bottle" (the whole Windows install, mostly registry), "both" (set
# on a bottle, and an app in it can override it) or "app" (one program only). Values live in
# bottle.conf and <app>.app.conf as key=value; a missing key means the default.
SETTING_KEYS="graphics windows_version virtual_desktop retina dpi option_as_alt command_as_ctrl fullscreen_capture msync cpu_cores hud wine_debug dll_overrides env args"

# key -> "scope|type|default|choices|description"
setting_meta() {
  case "$1" in
    graphics)           echo "both|choice|auto|auto turbo compat|Graphics engine. Turbo draws Direct3D 10/11 with Metal (DXMT); compat uses Wine's OpenGL path (slower, but some older games need it); auto picks turbo when it's built." ;;
    windows_version)    echo "bottle|choice|win10|win11 win10 win81 win8 win7 vista winxp64|The Windows version programs see. Old games and installers sometimes want win7 or winxp64." ;;
    virtual_desktop)    echo "bottle|text|off||Run everything in this bottle inside one Windows desktop window, like a VM: off, or a size such as 1920x1080." ;;
    retina)             echo "bottle|bool|off||Full Retina resolution. Sharper but slower; pair it with dpi 192 so text isn't tiny." ;;
    dpi)                echo "bottle|int|96||Text and window scale: 96 is 100%, 144 is 150%, 192 is 200%." ;;
    option_as_alt)      echo "bottle|bool|on||The Option keys act as Alt (games use Alt a lot)." ;;
    command_as_ctrl)    echo "bottle|bool|off||The Command keys act as Ctrl, so Cmd-C and Cmd-V work in Windows apps. Mac shortcuts like Cmd-Q stop working inside them." ;;
    fullscreen_capture) echo "bottle|bool|off||Fullscreen programs take over the whole display. Can fix games that change resolution; off keeps Mission Control and Spaces working." ;;
    msync)              echo "both|bool|on||Fast thread syncing (msync). Turn it off if a program hangs at start." ;;
    cpu_cores)          echo "both|int|0||Limit how many CPU cores programs see (0 = all). Some older games crash on Macs with many cores." ;;
    hud)                echo "both|bool|off||Show Apple's Metal performance HUD (frame rate) in turbo graphics." ;;
    wine_debug)         echo "both|choice|off|off errors verbose|How much Wine writes to the logs. Use errors or verbose when reporting a problem." ;;
    dll_overrides)      echo "both|text|||Wine DLL overrides, for example d3dx9_43=n,b;xinput1_3=n. An app's overrides are added after its bottle's." ;;
    env)                echo "both|text|||Extra environment variables, for example DXMT_LOG_LEVEL=info;FOO=1. An app's are added after its bottle's." ;;
    args)               echo "app|text|||Extra launch options passed to the program." ;;
    *) return 1 ;;
  esac
}
setting_field() { setting_meta "$1" | cut -d'|' -f"$2"; } # key field-number
setting_default() { setting_field "$1" 3; }

# Checks a value and prints it in its stored form ("yes" -> "on"). "default" -> empty.
setting_normalize() { # key value
  local key="$1" v="$2" type choices
  type=$(setting_field "$key" 2) || die "unknown setting '$key' (see: burrow settings --list)"
  case "$v" in *"
"*) die "values can't contain line breaks" ;; esac
  [ "$v" = default ] && { printf ''; return 0; }
  case "$type" in
    bool)
      case "$(printf '%s' "$v" | tr '[:upper:]' '[:lower:]')" in
        on|yes|true|1|y) v=on ;; off|no|false|0|n) v=off ;; *) die "$key is on or off" ;;
      esac ;;
    int)
      case "$v" in ''|*[!0-9]*) die "$key needs a whole number" ;; esac
      v=$((10#$v))
      case "$key" in
        dpi) [ "$v" -ge 72 ] && [ "$v" -le 480 ] || die "dpi goes from 72 to 480" ;;
        cpu_cores) [ "$v" -le 256 ] || die "cpu_cores goes from 0 (all) to 256" ;;
      esac ;;
    choice)
      [ "$key" = windows_version ] && [ "$v" = winxp ] && v=winxp64
      choices=" $(setting_field "$key" 4) "
      case "$choices" in *" $v "*) ;; *) die "$key is one of:$(printf '%s' "$choices" | sed 's/ $//')" ;; esac ;;
    text)
      case "$key" in
        virtual_desktop)
          v=$(printf '%s' "$v" | tr '[:upper:]' '[:lower:]')
          case "$v" in off|no|0) v=off ;; *) printf '%s' "$v" | grep -qE '^[1-9][0-9]{2,4}x[1-9][0-9]{2,4}$' || die "virtual_desktop is off or a size like 1920x1080" ;; esac ;;
        env)
          local e saved_ifs="$IFS"; IFS=';'
          for e in $v; do
            [ -z "$e" ] && continue
            printf '%s' "$e" | grep -qE '^[A-Za-z_][A-Za-z0-9_]*=' || { IFS="$saved_ifs"; die "env entries look like NAME=value, separated by ;"; }
          done
          IFS="$saved_ifs" ;;
      esac ;;
  esac
  printf '%s' "$v"
}

conf_unset() { # file key
  [ -f "$1" ] || return 0
  local tmp="$1.tmp.$$"
  grep -v "^$2=" "$1" > "$tmp"; mv "$tmp" "$1"
}

# A setting's raw value in one place, or nothing. Reads the keys older versions wrote too.
setting_raw() { # conf-file key
  local v
  v=$(conf_get "$1" "$2" 2>/dev/null) || v=""
  if [ -z "$v" ]; then
    case "$2" in
      graphics) [ "$(conf_get "$1" engine 2>/dev/null)" = "$STOCK_ENGINE" ] && v=compat ;;
      dll_overrides) v=$(conf_get "$1" dlloverrides 2>/dev/null) || v="" ;;
    esac
  fi
  # An app saying "auto" graphics means "whatever its bottle uses".
  case "$1" in *.app.conf) [ "$2" = graphics ] && [ "$v" = auto ] && v="" ;; esac
  printf '%s' "$v"
}

# The value that applies, and where it came from: prints "value<TAB>app|bottle|default".
setting_resolve() { # bottle app-id key
  local scope v; scope=$(setting_field "$3" 1)
  if [ -n "$2" ] && [ "$scope" != bottle ]; then
    v=$(setting_raw "$(lib_file "$2")" "$3")
    [ -n "$v" ] && { printf '%s\tapp' "$v"; return; }
  fi
  if [ "$scope" != app ]; then
    v=$(setting_raw "$(bottle_conf "$1")" "$3")
    [ -n "$v" ] && { printf '%s\tbottle' "$v"; return; }
  fi
  printf '%s\tdefault' "$(setting_default "$3")"
}
setting_get() { setting_resolve "$@" | cut -f1; }

# Presets set every bottle setting except dll_overrides and env; the rest go back to defaults.
PRESETS="gaming apps legacy retro desktop"
preset_meta() { # name -> "description|settings"
  case "$1" in
    gaming)  echo "Steam and modern 3D games: turbo graphics, Windows 10.|graphics=auto windows_version=win10" ;;
    apps)    echo "Office, creative and other desktop apps: sharp Retina text, Cmd-C/Cmd-V as Ctrl.|retina=on dpi=192 command_as_ctrl=on windows_version=win10" ;;
    legacy)  echo "Games and programs from the Windows 7 era: OpenGL graphics, Windows 7, 8 cores.|graphics=compat windows_version=win7 cpu_cores=8" ;;
    retro)   echo "Windows XP-era games: Windows XP, OpenGL, 2 cores, in an 1024x768 desktop window.|graphics=compat windows_version=winxp64 cpu_cores=2 virtual_desktop=1024x768" ;;
    desktop) echo "A whole Windows desktop in one Mac window, like a lightweight VM.|virtual_desktop=1600x1000 command_as_ctrl=on windows_version=win10" ;;
    *) return 1 ;;
  esac
}

apply_preset() { # bottle preset
  local conf meta key pair; conf=$(bottle_conf "$1")
  meta=$(preset_meta "$2") || die "unknown preset '$2' (one of: $PRESETS)"
  for key in $SETTING_KEYS; do
    case "$key" in dll_overrides|env|args) continue ;; esac
    conf_unset "$conf" "$key"
  done
  conf_unset "$conf" engine
  for pair in ${meta#*|}; do conf_set "$conf" "${pair%%=*}" "${pair#*=}"; done
  conf_set "$conf" preset "$2"
}

# --- Bottles (one Windows install each) ------------------------------------------------------
bottle_dir()    { printf '%s/%s' "$BOTTLES" "$1"; }
bottle_prefix() { printf '%s/%s/prefix' "$BOTTLES" "$1"; }
bottle_conf()   { printf '%s/%s/bottle.conf' "$BOTTLES" "$1"; }
bottle_exists() { [ -d "$(bottle_prefix "$1")/drive_c" ]; }

graphics_engine() { # graphics-setting -> engine
  case "$1" in
    turbo|dxmt) engine_ok "$TURBO_ENGINE" || die "turbo graphics isn't built yet; run: burrow turbo"; echo "$TURBO_ENGINE" ;;
    compat|wined3d) echo "$STOCK_ENGINE" ;;
    auto|"") best_engine ;;
    *) die "unknown graphics mode '$1' (use auto, turbo or compat)" ;;
  esac
}
bottle_engine() { graphics_engine "$(setting_get "$1" "" graphics)"; }

# Just enough to talk to a bottle's wineserver (stopping it, deleting the bottle).
bottle_env() { # bottle
  WINE=$(engine_wine "$(bottle_engine "$1")") || WINE=$(engine_wine "$STOCK_ENGINE") || return 1
  WINESERVER=$(engine_wineserver "$(bottle_engine "$1")")
  export WINEPREFIX; WINEPREFIX=$(bottle_prefix "$1")
}

# The registry side of a bottle's settings, as a .reg file Wine imports in one go.
reg_yn() { if [ "$(setting_get "$1" "" "$2")" = on ]; then echo y; else echo n; fi; } # bottle key
bottle_registry() { # bottle
  local b="$1" desk dpi
  desk=$(setting_get "$b" "" virtual_desktop)
  dpi=$(setting_get "$b" "" dpi)
  printf 'Windows Registry Editor Version 5.00\r\n\r\n'
  printf '[HKEY_CURRENT_USER\\Software\\Wine]\r\n"Version"="%s"\r\n\r\n' "$(setting_get "$b" "" windows_version)"
  printf '[HKEY_CURRENT_USER\\Software\\Wine\\Mac Driver]\r\n'
  printf '"LeftOptionIsAlt"="%s"\r\n"RightOptionIsAlt"="%s"\r\n' "$(reg_yn "$b" option_as_alt)" "$(reg_yn "$b" option_as_alt)"
  printf '"LeftCommandIsCtrl"="%s"\r\n"RightCommandIsCtrl"="%s"\r\n' "$(reg_yn "$b" command_as_ctrl)" "$(reg_yn "$b" command_as_ctrl)"
  printf '"RetinaMode"="%s"\r\n"CaptureDisplaysForFullscreen"="%s"\r\n\r\n' "$(reg_yn "$b" retina)" "$(reg_yn "$b" fullscreen_capture)"
  # winecfg's DPI lives under the current hardware profile; older Wine read the user key.
  printf '[HKEY_LOCAL_MACHINE\\System\\CurrentControlSet\\Hardware Profiles\\Current\\Software\\Fonts]\r\n"LogPixels"=dword:%08x\r\n\r\n' "$dpi"
  printf '[HKEY_CURRENT_USER\\Control Panel\\Desktop]\r\n"LogPixels"=dword:%08x\r\n\r\n' "$dpi"
  if [ "$desk" = off ]; then
    printf '[HKEY_CURRENT_USER\\Software\\Wine\\Explorer]\r\n"Desktop"=-\r\n\r\n'
  else
    printf '[HKEY_CURRENT_USER\\Software\\Wine\\Explorer]\r\n"Desktop"="Burrow"\r\n\r\n'
    printf '[HKEY_CURRENT_USER\\Software\\Wine\\Explorer\\Desktops]\r\n"Burrow"="%s"\r\n\r\n' "$desk"
  fi
}

# Imports the registry settings when they changed since the last import.
apply_bottle_registry() { # bottle (WINE, WINESERVER and WINEPREFIX already set)
  local conf want have reg
  conf=$(bottle_conf "$1")
  want=$(bottle_registry "$1" | cksum | awk '{print $1}')
  have=$(conf_get "$conf" reg_applied 2>/dev/null) || have=""
  [ "$want" = "$have" ] && return 0
  [ -d "$WINEPREFIX/drive_c" ] || return 0
  reg="$WINEPREFIX/drive_c/burrow-settings.reg"
  bottle_registry "$1" > "$reg"
  "$WINE" reg import 'C:\burrow-settings.reg' >/dev/null 2>&1 || warn "Wine couldn't apply some settings to '$1'"
  "$WINESERVER" -w 2>/dev/null
  rm -f "$reg"
  conf_set "$conf" reg_applied "$want"
}

# Exports the environment for running Wine in a bottle (and optionally as one library app).
# Sets WINE, WINESERVER and BOTTLE_ENGINE.
use_bottle() { # bottle [graphics] [app-id]
  local bottle="$1" graphics="${2:-}" app="${3:-}" engine
  [ -n "$graphics" ] && [ "$graphics" != auto ] || graphics=$(setting_get "$bottle" "$app" graphics)
  engine=$(graphics_engine "$graphics") || exit 1
  WINE=$(engine_wine "$engine") || die "Wine isn't set up yet; run: burrow setup"
  WINESERVER=$(engine_wineserver "$engine")
  export WINEPREFIX; WINEPREFIX=$(bottle_prefix "$bottle")

  local dbg; dbg=$(setting_get "$bottle" "$app" wine_debug)
  case "$dbg" in errors) dbg="-all,err+all" ;; verbose) dbg="err+all,warn+all,fixme-all" ;; *) dbg="-all" ;; esac
  export WINEDEBUG="${BURROW_WINEDEBUG:-$dbg}"
  if [ "$(setting_get "$bottle" "$app" msync)" = on ]; then export WINEMSYNC=1; else export WINEMSYNC=0; fi
  export MVK_CONFIG_LOG_LEVEL=1      # MoltenVK: errors only
  unset MTL_HUD_ENABLED WINE_CPU_TOPOLOGY
  { [ "${BURROW_HUD:-0}" = 1 ] || [ "$(setting_get "$bottle" "$app" hud)" = on ]; } && export MTL_HUD_ENABLED=1
  local cores; cores=$(setting_get "$bottle" "$app" cpu_cores)
  if [ "${cores:-0}" -gt 0 ]; then
    local i=1 list=0
    while [ "$i" -lt "$cores" ]; do list="$list,$i"; i=$((i + 1)); done
    export WINE_CPU_TOPOLOGY="$cores:$list"
  fi

  # Stock Wine draws D3D11 with its own OpenGL path; force builtin so DLLs a game or
  # installer dropped into the bottle can't take over. Turbo's builtins are DXMT.
  local overrides="d3d11,dxgi,d3d10core=b" more
  [ "$engine" = "$TURBO_ENGINE" ] && overrides="$overrides;winemetal=b"
  more=$(setting_raw "$(bottle_conf "$bottle")" dll_overrides)
  [ -n "$more" ] && overrides="$overrides;$more"
  if [ -n "$app" ]; then more=$(setting_raw "$(lib_file "$app")" dll_overrides); [ -n "$more" ] && overrides="$overrides;$more"; fi
  export WINEDLLOVERRIDES="$overrides"

  # Extra environment: the bottle's, then the app's (later entries win).
  BURROW_USER_ENV=""
  local e envs saved_ifs="$IFS"
  envs=$(setting_raw "$(bottle_conf "$bottle")" env)
  [ -n "$app" ] && envs="$envs;$(setting_raw "$(lib_file "$app")" env)"
  IFS=';'
  for e in $envs; do
    case "$e" in [A-Za-z_]*=*) export "${e?}"; BURROW_USER_ENV="$BURROW_USER_ENV ${e%%=*}" ;; esac
  done
  IFS="$saved_ifs"

  if [ -d /Library/Frameworks/GStreamer.framework/Libraries ] && is_mac; then
    # In-game videos (Unity/Unreal intros) play through Wine's GStreamer bridge.
    export GST_PLUGIN_SYSTEM_PATH_1_0=/Library/Frameworks/GStreamer.framework/Libraries/gstreamer-1.0
    export DYLD_FALLBACK_LIBRARY_PATH="/Library/Frameworks/GStreamer.framework/Libraries${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
  fi
  # A bottle that switched engines needs its system folder refreshed (DXMT's winemetal.dll
  # is copied into system32 by wineboot).
  local conf; conf=$(bottle_conf "$bottle")
  if [ "$(conf_get "$conf" last_engine 2>/dev/null)" != "$engine" ] && [ -d "$WINEPREFIX/drive_c" ]; then
    "$WINE" wineboot -u >/dev/null 2>&1
    "$WINESERVER" -w 2>/dev/null
    conf_set "$conf" last_engine "$engine"
  fi
  apply_bottle_registry "$bottle"
  BOTTLE_ENGINE="$engine"
}

new_log() { # name -> log path (keeps the newest 20 per name)
  mkdir -p "$LOGS"
  local base; base=$(slugify "$1")
  ls -1t "$LOGS/$base"-*.log 2>/dev/null | tail -n +20 | while IFS= read -r old; do rm -f "$old"; done
  printf '%s/%s-%s.log' "$LOGS" "$base" "$(date +%Y%m%d-%H%M%S)"
}

cmd_bottle_create() { # name [preset]
  local name="$1" preset="${2:-}" dir
  [ -n "$name" ] || die "give the bottle a name"
  case "$name" in */*|.*|*"	"*) die "bottle names can't contain / or tabs, or start with ." ;; esac
  [ -z "$preset" ] || preset_meta "$preset" >/dev/null || die "unknown preset '$preset' (one of: $PRESETS)"
  dir=$(bottle_dir "$name")
  if bottle_exists "$name"; then
    [ -n "$preset" ] && { apply_preset "$name" "$preset"; settings_apply_now "$name"; ok "Bottle '$name' now uses the $preset preset"; return 0; }
    ok "Bottle '$name' already exists"; return 0
  fi
  mkdir -p "$dir"
  touch "$(bottle_conf "$name")"
  [ -n "$preset" ] && apply_preset "$name" "$preset"
  step "Creating bottle '$name' (a fresh Windows folder)…"
  use_bottle "$name"
  "$WINE" wineboot -i >/dev/null 2>&1
  "$WINESERVER" -w 2>/dev/null
  [ -d "$WINEPREFIX/drive_c" ] || die "Wine couldn't create the bottle; try: BURROW_WINEDEBUG=err+all burrow bottle new '$name'"
  apply_bottle_registry "$name"
  conf_set "$(bottle_conf "$name")" last_engine "$BOTTLE_ENGINE"
  ok "Bottle '$name' is ready${preset:+ ($preset preset)}"
}

# Stops everything running in a bottle.
stop_bottle() { ( bottle_env "$1" && "$WINESERVER" -k ) >/dev/null 2>&1; return 0; }

# True when Wine programs are running in the bottle.
bottle_busy() { running_procs | cut -f1 | grep -qxF "$1"; }

cmd_bottle() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    new|create)
      local name="" preset=""
      while [ $# -gt 0 ]; do
        case "$1" in --preset) preset="${2:-}"; shift 2 ;; *) name="$1"; shift ;; esac
      done
      cmd_bottle_create "$name" "$preset" ;;
    list|ls)
      local d n plain=0; [ "${1:-}" = --plain ] && plain=1
      [ -d "$BOTTLES" ] || { [ "$plain" = 1 ] || say "No bottles yet."; return 0; }
      for d in "$BOTTLES"/*/; do
        [ -d "$d" ] || continue
        n=$(basename "$d")
        if [ "$plain" = 1 ]; then
          # For Burrow.app: name, graphics, windows version, preset, virtual desktop.
          printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$(setting_get "$n" "" graphics)" "$(setting_get "$n" "" windows_version)" \
            "$(conf_get "$(bottle_conf "$n")" preset 2>/dev/null)" "$(setting_get "$n" "" virtual_desktop)"
        else
          printf '%-20s %-7s %-8s %s\n' "$n" "$(setting_get "$n" "" graphics)" "$(setting_get "$n" "" windows_version)" \
            "$(conf_get "$(bottle_conf "$n")" preset 2>/dev/null)"
        fi
      done ;;
    delete|rm)
      local name="${1:-}"; [ -n "$name" ] || die "which bottle?"
      bottle_exists "$name" || [ -d "$(bottle_dir "$name")" ] || die "no bottle named '$name'"
      if [ "${2:-}" != "--yes" ]; then
        printf 'Delete bottle %s and everything installed in it? Type its name to confirm: ' "$name"
        local answer; read -r answer; [ "$answer" = "$name" ] || die "not deleted"
      fi
      stop_bottle "$name"
      rm -rf "${BOTTLES:?}/${name:?}" "${SNAPSHOTS:?}/${name:?}"
      grep -lxF "bottle=$name" "$LIBRARY"/*.app.conf 2>/dev/null | while IFS= read -r f; do rm -f "$f"; done
      ok "Deleted bottle '$name'" ;;
    clone|copy|duplicate)
      local src="${1:-}" dst="${2:-}"
      bottle_exists "$src" || die "no bottle named '$src'"
      [ -n "$dst" ] || die "usage: burrow bottle clone <bottle> <new name>"
      case "$dst" in */*|.*) die "bottle names can't contain / or start with ." ;; esac
      [ -e "$(bottle_dir "$dst")" ] && die "there's already a bottle named '$dst'"
      bottle_busy "$src" && die "quit the programs running in '$src' first (burrow kill '$src')"
      step "Copying bottle '$src' to '$dst'…"
      clone_tree "$(bottle_dir "$src")" "$(bottle_dir "$dst")" || die "couldn't copy the bottle"
      ok "Made bottle '$dst' (programs in it aren't in your library; add them with burrow add)" ;;
    engine)
      local name="${1:-}" e="${2:-}"; bottle_exists "$name" || die "no bottle named '$name'"
      case "$e" in auto|turbo) e=auto ;; compat|stock) e=compat ;; *) die "use: burrow bottle engine <bottle> auto|compat" ;; esac
      cmd_settings "$name" graphics "$e" ;;
    *) die "unknown: burrow bottle $sub (new, list, clone, delete, engine)" ;;
  esac
}

# burrow settings <bottle> | --app <app>  [--plain] [key | key value | key=value… | preset NAME]
cmd_settings() {
  local bottle="" app="" plain=0 rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --app) app="${2:-}"; shift 2 ;;
      --plain) plain=1; shift ;;
      --list) settings_list; return 0 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  local conf
  if [ -n "$app" ]; then
    app=$(lib_find "$app") || die "no app called '$app' (see: burrow apps)"
    conf=$(lib_file "$app"); bottle=$(conf_get "$conf" bottle)
  else
    [ ${#rest[@]} -gt 0 ] || die "usage: burrow settings <bottle> [key [value]]  or  burrow settings --app <app> …"
    bottle="${rest[0]}"
    if [ ${#rest[@]} -gt 1 ]; then rest=("${rest[@]:1}"); else rest=(); fi
    bottle_exists "$bottle" || die "no bottle named '$bottle' (see: burrow bottle list)"
    conf=$(bottle_conf "$bottle")
  fi

  # Show everything.
  if [ ${#rest[@]} -eq 0 ]; then settings_show "$bottle" "$app" "$plain"; return 0; fi

  # A preset (bottles only).
  if [ "${rest[0]}" = preset ]; then
    [ -z "$app" ] || die "presets are for bottles; the app follows its bottle"
    apply_preset "$bottle" "${rest[1]:-}"
    settings_apply_now "$bottle"
    ok "Bottle '$bottle' now uses the ${rest[1]} preset"; return 0
  fi

  # One value.
  if [ ${#rest[@]} -eq 1 ] && [ "${rest[0]#*=}" = "${rest[0]}" ]; then
    setting_meta "${rest[0]}" >/dev/null || die "unknown setting '${rest[0]}' (see: burrow settings --list)"
    setting_get "$bottle" "$app" "${rest[0]}"; echo; return 0
  fi

  # Set: "key value" or any number of key=value.
  local pairs=() p key val
  if [ ${#rest[@]} -eq 2 ] && [ "${rest[0]#*=}" = "${rest[0]}" ]; then pairs=("${rest[0]}=${rest[1]}")
  else pairs=("${rest[@]}"); fi
  # Check everything before changing anything.
  for p in "${pairs[@]}"; do
    case "$p" in *=*) ;; *) die "use key=value (got '$p')" ;; esac
    key="${p%%=*}"
    setting_meta "$key" >/dev/null || die "unknown setting '$key' (see: burrow settings --list)"
    case "$(setting_field "$key" 1)" in
      bottle) [ -z "$app" ] || die "$key applies to the whole bottle; set it with: burrow settings '$bottle' $key …" ;;
      app) [ -n "$app" ] || die "$key is set per app: burrow settings --app <app> $key …" ;;
    esac
    setting_normalize "$key" "${p#*=}" >/dev/null || exit 1
  done
  for p in "${pairs[@]}"; do
    key="${p%%=*}"; val=$(setting_normalize "$key" "${p#*=}")
    if [ -z "$val" ]; then conf_unset "$conf" "$key"; else conf_set "$conf" "$key" "$val"; fi
    [ "$key" = graphics ] && conf_unset "$conf" engine
    [ "$key" = dll_overrides ] && conf_unset "$conf" dlloverrides
    ok "$key = $(setting_get "$bottle" "$app" "$key")${app:+ (for $(conf_get "$conf" name))}"
  done
  [ -z "$app" ] && conf_unset "$conf" preset
  [ -z "$app" ] && settings_apply_now "$bottle"
  return 0
}

# Registry settings go into the bottle straight away when Wine is installed; otherwise on
# the next start.
settings_apply_now() { # bottle
  local e; e=$(bottle_engine "$1" 2>/dev/null) || return 0
  engine_ok "$e" || return 0
  ( use_bottle "$1" ) >/dev/null 2>&1 || warn "settings saved; they apply the next time '$1' starts"
}

settings_show() { # bottle app plain
  local key scope res src
  for key in $SETTING_KEYS; do
    scope=$(setting_field "$key" 1)
    if [ -n "$2" ]; then [ "$scope" = bottle ] && continue; else [ "$scope" = app ] && continue; fi
    res=$(setting_resolve "$1" "$2" "$key")
    if [ "$3" = 1 ]; then
      # key, value, source, type, choices, default, scope, description
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$key" "${res%	*}" "${res##*	}" "$(setting_field "$key" 2)" \
        "$(setting_field "$key" 4)" "$(setting_default "$key")" "$scope" "$(setting_field "$key" 5)"
    else
      src="${res##*	}"; if [ "$src" = default ]; then src="${D}default${N}"; else src="${B}$src${N}"; fi
      printf '  %-20s %-24s %s\n' "$key" "${res%	*}" "$src"
    fi
  done
  if [ "$3" != 1 ] && [ -z "$2" ]; then
    local preset; preset=$(conf_get "$(bottle_conf "$1")" preset 2>/dev/null) && say "  ${D}preset: $preset${N}"
  fi
  return 0
}

settings_list() {
  local key
  say "${B}Settings${N} (burrow settings <bottle> key value, or --app <app> for one program)"
  for key in $SETTING_KEYS; do
    printf '\n  %s%s%s  [%s; default: %s]\n' "$B" "$key" "$N" "$(setting_field "$key" 1 | sed 's/both/bottle or app/')" "$(setting_default "$key" | sed 's/^$/none/')"
    [ -n "$(setting_field "$key" 4)" ] && printf '    one of: %s\n' "$(setting_field "$key" 4)"
    printf '    %s\n' "$(setting_field "$key" 5)"
  done
  say ""; say "Set a value to 'default' to clear it. Presets: burrow presets"
}

cmd_presets() {
  local p meta
  for p in $PRESETS; do
    meta=$(preset_meta "$p")
    if [ "${1:-}" = --plain ]; then printf '%s\t%s\t%s\n' "$p" "${meta%%|*}" "${meta#*|}"
    else printf '  %s%-8s%s %s\n           %s%s%s\n' "$B" "$p" "$N" "${meta%%|*}" "$D" "${meta#*|}" "$N"; fi
  done
}

# --- Snapshots: save a bottle and roll back to it ------------------------------------------------
# On a Mac each snapshot is an APFS clone, so it takes seconds and almost no space until the
# bottle changes.
snapshot_dir() { printf '%s/%s/%s' "$SNAPSHOTS" "$1" "$2"; }

cmd_snapshot() {
  local sub="${1:-}" bottle="${2:-}"; shift 2 2>/dev/null || shift $#
  [ -n "$bottle" ] || die "usage: burrow snapshot save|list|restore|delete <bottle> …"
  bottle_exists "$bottle" || die "no bottle named '$bottle'"
  case "$sub" in
    save|take|new)
      local label="${1:-}" force="${2:-}"
      [ "$label" = --force ] && { force=--force; label=""; }
      if bottle_busy "$bottle"; then
        [ "$force" = --force ] || die "programs are running in '$bottle'; quit them first (or add --force to stop them)"
        stop_bottle "$bottle"
      fi
      local id dir n=2; id=$(date +%Y%m%d-%H%M%S); dir=$(snapshot_dir "$bottle" "$id")
      while [ -e "$dir" ]; do dir=$(snapshot_dir "$bottle" "$id-$n"); n=$((n + 1)); done
      id=$(basename "$dir")
      mkdir -p "$dir"
      step "Saving a snapshot of '$bottle'…"
      clone_tree "$(bottle_prefix "$bottle")" "$dir/prefix" || { rm -rf "${dir:?}"; die "couldn't copy the bottle"; }
      cp "$(bottle_conf "$bottle")" "$dir/bottle.conf" 2>/dev/null
      { printf 'label=%s\n' "${label:-Snapshot}"; printf 'created=%s\n' "$(date '+%Y-%m-%d %H:%M')"; } > "$dir/snapshot.conf"
      ok "Saved snapshot $id${label:+ ($label)}" ;;
    list|ls)
      local d any=0
      for d in "$SNAPSHOTS/$bottle"/*/; do
        [ -f "$d/snapshot.conf" ] || continue; any=1
        if [ "${1:-}" = --plain ]; then
          printf '%s\t%s\t%s\n' "$(basename "$d")" "$(conf_get "$d/snapshot.conf" label)" "$(conf_get "$d/snapshot.conf" created)"
        else
          printf '  %-18s %-17s %s\n' "$(basename "$d")" "$(conf_get "$d/snapshot.conf" created)" "$(conf_get "$d/snapshot.conf" label)"
        fi
      done
      [ "$any" = 1 ] || [ "${1:-}" = --plain ] || say "No snapshots of '$bottle' yet. Make one with: burrow snapshot save '$bottle' \"label\"" ;;
    restore)
      local id="${1:-}" dir prefix; [ -n "$id" ] || die "which snapshot? (see: burrow snapshot list '$bottle')"
      case "$id" in */*|.*) die "no snapshot '$id' for '$bottle'" ;; esac
      dir=$(snapshot_dir "$bottle" "$id"); [ -d "$dir/prefix/drive_c" ] || die "no snapshot '$id' for '$bottle'"
      stop_bottle "$bottle"
      prefix=$(bottle_prefix "$bottle")
      step "Rolling '$bottle' back to $id…"
      mv "$prefix" "$prefix.old.$$" || die "couldn't move the bottle aside"
      if ! clone_tree "$dir/prefix" "$prefix"; then rm -rf "${prefix:?}"; mv "$prefix.old.$$" "$prefix"; die "couldn't restore the snapshot"; fi
      rm -rf "${prefix:?}.old.$$"
      [ -f "$dir/bottle.conf" ] && cp "$dir/bottle.conf" "$(bottle_conf "$bottle")"
      ok "'$bottle' is back to $id ($(conf_get "$dir/snapshot.conf" label))" ;;
    delete|rm)
      local id="${1:-}"; [ -n "$id" ] || die "which snapshot?"
      case "$id" in */*|.*) die "no snapshot '$id' for '$bottle'" ;; esac
      [ -d "$(snapshot_dir "$bottle" "$id")" ] || die "no snapshot '$id' for '$bottle'"
      rm -rf "${SNAPSHOTS:?}/${bottle:?}/${id:?}"; ok "Deleted snapshot $id" ;;
    *) die "unknown: burrow snapshot $sub (save, list, restore, delete)" ;;
  esac
}

# --- Windows desktop: the bottle as one window, like a VM ---------------------------------------
cmd_desktop() { # bottle [size]
  local bottle="${1:-}" size="${2:-}"
  [ -n "$bottle" ] || die "usage: burrow desktop <bottle> [1600x1000]"
  bottle_exists "$bottle" || die "no bottle named '$bottle'"
  [ -n "$size" ] || size=$(setting_get "$bottle" "" virtual_desktop)
  [ "$size" = off ] && size=1600x1000
  size=$(setting_normalize virtual_desktop "$size") || exit 1
  use_bottle "$bottle"
  local log; log=$(new_log "desktop-$bottle")
  step "Opening the Windows desktop of '$bottle' ($size)…  log: $log"
  # Named like the desktop the virtual_desktop setting uses, so programs started from the
  # library while it's open land in the same window.
  "$WINE" explorer "/desktop=Burrow,$size" explorer.exe 'C:\' >>"$log" 2>&1 &
  [ "${BURROW_FOREGROUND:-0}" = 1 ] && wait
  return 0
}

# --- Windows components (Visual C++, .NET, fonts…) through winetricks ------------------------------
WINETRICKS_VERSION="${BURROW_WINETRICKS_VERSION:-20240105}"
WINETRICKS_URL="${BURROW_WINETRICKS_URL:-https://raw.githubusercontent.com/Winetricks/winetricks/$WINETRICKS_VERSION/src/winetricks}"
COMPONENTS="vcrun2022 vcrun2013 vcrun2010 vcrun2008 dotnet48 d3dx9 d3dcompiler_47 xact physx corefonts cjkfonts"
component_meta() {
  case "$1" in
    vcrun2022) echo "Visual C++ 2015-2022 runtime (most modern programs and games)" ;;
    vcrun2013) echo "Visual C++ 2013 runtime" ;;
    vcrun2010) echo "Visual C++ 2010 runtime" ;;
    vcrun2008) echo "Visual C++ 2008 runtime (older games)" ;;
    dotnet48)  echo ".NET Framework 4.8 (many tools and launchers; slow to install)" ;;
    d3dx9)     echo "DirectX 9 helper libraries (older games)" ;;
    d3dcompiler_47) echo "Direct3D shader compiler" ;;
    xact)      echo "XACT audio (games with missing sound)" ;;
    physx)     echo "NVIDIA PhysX runtime" ;;
    corefonts) echo "Microsoft core fonts (Arial, Times New Roman…)" ;;
    cjkfonts)  echo "Chinese, Japanese and Korean fonts" ;;
    *) return 1 ;;
  esac
}

winetricks_path() {
  if [ -n "${BURROW_WINETRICKS:-}" ]; then printf '%s' "$BURROW_WINETRICKS"; return; fi
  local wt="$RUNTIMES/winetricks-$WINETRICKS_VERSION"
  if [ ! -x "$wt" ]; then
    step "Downloading winetricks $WINETRICKS_VERSION (installs Windows components)…" >&2
    download "$WINETRICKS_URL" "$wt" >&2 || die "couldn't download winetricks"
    chmod +x "$wt"
  fi
  printf '%s' "$wt"
}

cmd_components() { # bottle [list [--plain] | install verb…]
  local bottle="${1:-}" sub="${2:-list}"; shift 2 2>/dev/null || shift $#
  [ -n "$bottle" ] || die "usage: burrow components <bottle> [list | install vcrun2022 corefonts …]"
  bottle_exists "$bottle" || die "no bottle named '$bottle'"
  local log v have; log="$(bottle_prefix "$bottle")/winetricks.log"
  case "$sub" in
    list|ls)
      for v in $COMPONENTS; do
        have=0; grep -qx "$v" "$log" 2>/dev/null && have=1
        if [ "${1:-}" = --plain ]; then printf '%s\t%s\t%s\n' "$v" "$have" "$(component_meta "$v")"
        elif [ "$have" = 1 ]; then printf '  %s✓%s %-16s %s\n' "$G" "$N" "$v" "$(component_meta "$v")"
        else printf '    %-16s %s\n' "$v" "$(component_meta "$v")"; fi
      done
      [ "${1:-}" = --plain ] || say "  ${D}Any other winetricks name works too: burrow components '$bottle' install <name>${N}" ;;
    install|add)
      [ $# -gt 0 ] || die "which components? (see: burrow components '$bottle')"
      for v in "$@"; do case "$v" in -*|*[!A-Za-z0-9_.=-]*) die "'$v' isn't a component name" ;; esac; done
      if is_mac && ! command -v cabextract >/dev/null 2>&1; then
        local brew="" b
        for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do [ -x "$b" ] && brew="$b" && break; done
        [ -n "$brew" ] || die "Windows components need cabextract from Homebrew; install Homebrew (Setup tab) first"
        step "Installing cabextract with Homebrew…"; "$brew" install cabextract || die "Homebrew couldn't install cabextract"
        PATH="$("$brew" --prefix)/bin:$PATH"; export PATH
      fi
      local wt; wt=$(winetricks_path) || exit 1
      use_bottle "$bottle"
      local runlog; runlog=$(new_log "components-$bottle")
      step "Installing into '$bottle': $*  (this can take a while; log: $runlog)"
      WINETRICKS_LATEST_VERSION_CHECK=disabled WINE="$WINE" WINESERVER="$WINESERVER" \
        "$wt" --unattended "$@" 2>&1 | tee -a "$runlog"
      local rc=${PIPESTATUS[0]}
      "$WINESERVER" -w 2>/dev/null
      [ "$rc" = 0 ] || die "winetricks stopped with an error; see $runlog"
      ok "Installed: $*" ;;
    *) die "unknown: burrow components <bottle> $sub (list, install)" ;;
  esac
}

# --- Setup ---------------------------------------------------------------------------------------
check_mac() {
  is_mac || { warn "not a Mac; only the tests run here"; return 0; }
  local major; major=$(sw_vers -productVersion | cut -d. -f1)
  [ "$major" -ge 11 ] || die "Burrow needs macOS 11 or newer (this is $(sw_vers -productVersion))"
  if [ "$(uname -m)" = arm64 ]; then
    if ! /usr/bin/arch -x86_64 /usr/bin/true 2>/dev/null; then
      step "Installing Rosetta 2 (Apple's Intel translator; Wine needs it)…"
      softwareupdate --install-rosetta --agree-to-license || die "Rosetta didn't install; run: softwareupdate --install-rosetta"
    fi
    ok "Apple Silicon with Rosetta 2"
  else
    warn "Intel Mac: Windows programs will run, but turbo graphics (DXMT) needs Apple Silicon"
  fi
}

install_wine() {
  local root; root=$(engine_root "$STOCK_ENGINE")
  if engine_ok "$STOCK_ENGINE"; then ok "Wine $WINE_VERSION is installed"; return 0; fi
  step "Downloading Wine $WINE_VERSION (Gcenx's macOS build of the open source Wine project)…"
  local tar="$CACHE/wine-devel-$WINE_VERSION-osx64.tar.xz"
  if [ ! -f "$tar" ]; then
    download "$WINE_URL" "$tar" || {
      local url; url=$(release_asset "$WINE_RELEASE_API" 'wine-devel-.*osx64\.tar\.xz$')
      [ -n "$url" ] || die "couldn't download Wine $WINE_VERSION"
      download "$url" "$tar" || die "couldn't download Wine $WINE_VERSION"
    }
  fi
  local tmp="$ENGINES/.extract.$$"
  rm -rf "$tmp"; mkdir -p "$tmp"
  tar -xJf "$tar" -C "$tmp" || { rm -rf "$tmp"; rm -f "$tar"; die "the Wine download was damaged; run setup again"; }
  # The archive holds "Wine Devel.app/Contents/Resources/wine"; find the folder with bin/wine.
  local found
  found=$(find "$tmp" -type f \( -path '*/bin/wine' -o -path '*/bin/wine64' \) 2>/dev/null | head -1)
  [ -n "$found" ] || { rm -rf "$tmp"; die "no wine program in the download"; }
  rm -rf "$root"
  mv "$(dirname "$(dirname "$found")")" "$root"
  rm -rf "$tmp"
  is_mac && xattr -dr com.apple.quarantine "$root" 2>/dev/null
  engine_ok "$STOCK_ENGINE" || die "Wine didn't install correctly"
  ok "Wine $WINE_VERSION installed"
}

install_dxmt() {
  local dest="$RUNTIMES/dxmt-$DXMT_VERSION"
  if [ -d "$dest/x86_64-windows" ]; then ok "DXMT $DXMT_VERSION is downloaded"; return 0; fi
  step "Downloading DXMT $DXMT_VERSION (Direct3D 11 to Metal)…"
  local tgz="$CACHE/dxmt-$DXMT_VERSION-builtin.tar.gz"
  if [ ! -f "$tgz" ]; then
    download "$DXMT_URL" "$tgz" || {
      local url; url=$(release_asset "$DXMT_RELEASE_API" 'builtin.*\.tar\.gz$|\.tar\.gz$')
      [ -n "$url" ] || die "couldn't download DXMT"
      download "$url" "$tgz" || die "couldn't download DXMT"
    }
  fi
  local tmp="$RUNTIMES/.extract.$$"
  rm -rf "$tmp"; mkdir -p "$tmp"
  tar -xzf "$tgz" -C "$tmp" || { rm -rf "$tmp"; rm -f "$tgz"; die "the DXMT download was damaged; run setup again"; }
  local win; win=$(find "$tmp" -type d -name x86_64-windows | head -1)
  [ -n "$win" ] || { rm -rf "$tmp"; die "unexpected DXMT archive layout"; }
  rm -rf "$dest"; mv "$(dirname "$win")" "$dest"; rm -rf "$tmp"
  ok "DXMT $DXMT_VERSION downloaded"
}

cmd_setup() {
  step "Burrow $BURROW_VERSION setup"
  mkdir -p "$ENGINES" "$RUNTIMES" "$BOTTLES" "$LIBRARY" "$LOGS" "$CACHE"
  check_mac
  if [ -n "${BURROW_WINE:-}" ]; then ok "Using $BURROW_WINE"; else install_wine; fi
  install_dxmt
  if is_mac && [ ! -d /Library/Frameworks/GStreamer.framework ]; then
    warn "Optional: install GStreamer so in-game videos play (otherwise intros may be black):"
    warn "  https://gstreamer.freedesktop.org/download/#macos  (the 'runtime installer' .pkg)"
  fi
  if engine_ok "$TURBO_ENGINE"; then ok "Turbo graphics is built"
  else say ""; say "Next: ${B}burrow turbo${N} builds the fast Metal graphics most 3D games need (one time, a few minutes)."; fi
  say "Then: ${B}burrow steam${N} installs and opens Windows Steam."
}

# --- Turbo graphics: a DXMT-capable copy of Wine ---------------------------------------------
# DXMT draws through functions in Wine's Mac driver that stock builds keep private, so the
# driver (and a few DLLs games trip over) is rebuilt from the matching Wine source with the
# patches in engine/wine-patches (from Neutron, MIT; the patches are LGPL like Wine). Only
# those files are compiled, then DXMT's DLLs are laid over a clone of the stock engine.
cmd_turbo() {
  is_mac || [ "${BURROW_TURBO_ANYWHERE:-0}" = 1 ] || die "turbo graphics is built on the Mac itself"
  engine_ok "$STOCK_ENGINE" || cmd_setup
  install_dxmt
  if [ "${1:-}" != "--rebuild" ] && engine_ok "$TURBO_ENGINE"; then ok "Turbo graphics is already built (burrow turbo --rebuild to redo it)"; return 0; fi
  [ "$(uname -m)" = arm64 ] || warn "DXMT needs Apple Silicon; building anyway"

  step "Checking build tools…"
  if ! xcode-select -p >/dev/null 2>&1; then
    xcode-select --install 2>/dev/null
    die "install Apple's Command Line Tools in the window that just opened, then run: burrow turbo"
  fi
  local brew=""
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do [ -x "$b" ] && brew="$b" && break; done
  if [ -z "$brew" ]; then
    say "Turbo needs Homebrew (free, from brew.sh) for three build tools. Install it with:"
    say '  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
    die "then run: burrow turbo"
  fi
  local bp; bp=$("$brew" --prefix)
  local need=""
  [ -x "$bp/opt/bison/bin/bison" ] || need="$need bison"
  [ -x "$bp/opt/flex/bin/flex" ] || need="$need flex"
  command -v x86_64-w64-mingw32-gcc >/dev/null 2>&1 || [ -x "$bp/bin/x86_64-w64-mingw32-gcc" ] || need="$need mingw-w64"
  if [ -n "$need" ]; then
    step "Installing build tools with Homebrew:$need"
    # shellcheck disable=SC2086
    "$brew" install $need || die "Homebrew couldn't install:$need"
  fi
  export PATH="$bp/opt/bison/bin:$bp/opt/flex/bin:$bp/bin:$PATH"

  local stock wine version work src build patches
  stock=$(engine_root "$STOCK_ENGINE"); wine=$(engine_wine "$STOCK_ENGINE")
  version=$("$wine" --version 2>/dev/null | sed -n 's/^wine-\([0-9][0-9.]*\).*/\1/p')
  [ -n "$version" ] || die "couldn't read the Wine version"
  local major=${version%%.*} series
  case "$version" in *.0) series="$major.0" ;; *) series="$major.x" ;; esac
  work="$CACHE/turbo"; src="$work/wine-$version"; build="$work/build-$version"; patches="$APPDIR/engine/wine-patches"
  mkdir -p "$work"
  local applied="$src/.burrow-patches"
  if [ -d "$src" ] && [ ! -f "$applied" ]; then rm -rf "$src"; fi
  if [ ! -d "$src" ]; then
    [ -f "$work/wine-$version.tar.xz" ] || { step "Downloading the Wine $version source…"; download "https://dl.winehq.org/wine/source/$series/wine-$version.tar.xz" "$work/wine-$version.tar.xz" || die "couldn't download the Wine source"; }
    tar -xJf "$work/wine-$version.tar.xz" -C "$work" || die "couldn't unpack the Wine source"
    : > "$applied"
  fi
  local p name
  for p in "$patches"/*.patch; do
    name=$(basename "$p")
    grep -qx "$name" "$applied" && continue
    (cd "$src" && patch -p1 --forward --quiet < "$p") || die "patch $name doesn't fit Wine $version (the patches were tested on 11.18)"
    echo "$name" >> "$applied"
  done

  mkdir -p "$build"
  export MACOSX_DEPLOYMENT_TARGET=10.15
  if [ ! -f "$build/Makefile" ]; then
    step "Configuring the Wine build (a few minutes)…"
    (cd "$build" && "$src/configure" CC="clang -arch x86_64" OBJC="clang -arch x86_64" \
      --host=x86_64-apple-darwin --enable-archs=i386,x86_64 --disable-tests \
      --without-x --without-freetype --without-gstreamer --without-sdl --without-gnutls \
      --without-cups --without-sane --without-gphoto --without-ffmpeg --without-krb5 \
      --without-netapi --without-pcap --without-usb --without-inotify --without-capi \
      --without-v4l2 --without-wayland > configure.log 2>&1) \
      || { rm -f "$build/Makefile"; die "configure failed; see $build/configure.log"; }
  fi
  local pe_dlls n pe_targets=""
  pe_dlls=$(cd "$src/dlls" && ls -d d3dx9_* xaudio2_* xactengine* bcrypt opengl32)
  for n in $pe_dlls; do pe_targets="$pe_targets dlls/$n/i386-windows/$n.dll dlls/$n/x86_64-windows/$n.dll"; done
  step "Compiling the patched Mac driver and DLLs…"
  # shellcheck disable=SC2086
  make -C "$build" -j"$(cpu_count)" dlls/winemac.drv/winemac.so dlls/mfreadwrite/x86_64-windows/mfreadwrite.dll $pe_targets \
    > "$build/make.log" 2>&1 || die "build failed; see $build/make.log"
  nm -gU "$build/dlls/winemac.drv/winemac.so" | grep -q " _macdrv_functions$" || die "the patched driver doesn't export what DXMT needs"

  step "Assembling the turbo engine…"
  local out; out=$(engine_root "$TURBO_ENGINE")
  rm -rf "$out.new"; clone_tree "$stock" "$out.new" || die "couldn't copy the engine"
  cp "$build/dlls/winemac.drv/winemac.so" "$out.new/lib/wine/x86_64-unix/winemac.so"
  x86_64-w64-mingw32-strip -o "$out.new/lib/wine/x86_64-windows/mfreadwrite.dll" "$build/dlls/mfreadwrite/x86_64-windows/mfreadwrite.dll"
  for n in $pe_dlls; do
    i686-w64-mingw32-strip -o "$out.new/lib/wine/i386-windows/$n.dll" "$build/dlls/$n/i386-windows/$n.dll"
    x86_64-w64-mingw32-strip -o "$out.new/lib/wine/x86_64-windows/$n.dll" "$build/dlls/$n/x86_64-windows/$n.dll"
  done
  overlay_dxmt "$out.new"
  rm -rf "$out"; mv "$out.new" "$out"
  ok "Turbo graphics built. Bottles on 'auto' use it from now on."
  # The Command Line Tools are installed now; swap the simple menu for the window app.
  if [ -d "$HOME/Applications/Burrow.app" ] && [ ! -f "$HOME/Applications/Burrow.app/Contents/MacOS/Burrow" ]; then
    build_window_app "$HOME/Applications/Burrow.app" && ok "Upgraded Burrow.app to the window app"
  fi
}

overlay_dxmt() { # engine-root
  local dx="$RUNTIMES/dxmt-$DXMT_VERSION" arch f
  for arch in x86_64-windows i386-windows x86_64-unix; do
    [ -d "$dx/$arch" ] || continue
    for f in "$dx/$arch"/*; do [ -f "$f" ] && cp "$f" "$1/lib/wine/$arch/"; done
  done
}

# --- Library: programs you launch ----------------------------------------------------------------
lib_file() { printf '%s/%s.app.conf' "$LIBRARY" "$1"; }

# Adds a program to the library. target is a Windows path (C:\...), a .lnk or .exe in the bottle.
# The same name in the same bottle replaces the old entry (a reinstall); the same name in
# another bottle gets its own id ("name-2") so neither hides the other.
lib_add() { # name bottle target [args]
  local name="$1" bottle="$2" target="$3" args="${4:-}" id f n=2
  id=$(slugify "$name"); [ -n "$id" ] || id="app"
  f=$(lib_file "$id")
  if [ -f "$f" ] && [ "$(conf_get "$f" bottle)" != "$bottle" ]; then
    while [ -f "$(lib_file "$id-$n")" ] && [ "$(conf_get "$(lib_file "$id-$n")" bottle)" != "$bottle" ]; do n=$((n + 1)); done
    id="$id-$n"; f=$(lib_file "$id")
  fi
  mkdir -p "$LIBRARY"
  { printf 'name=%s\n' "$name"; printf 'bottle=%s\n' "$bottle"; printf 'target=%s\n' "$target"
    printf 'args=%s\n' "$args"; printf 'graphics=auto\n'; } > "$f"
  printf '%s' "$id"
}

# Finds an app by id or by name (case-insensitive).
lib_find() {
  local q="$1" f id
  [ -f "$(lib_file "$q")" ] && { printf '%s' "$q"; return 0; }
  id=$(slugify "$q"); [ -f "$(lib_file "$id")" ] && { printf '%s' "$id"; return 0; }
  for f in "$LIBRARY"/*.app.conf; do
    [ -f "$f" ] || continue
    if [ "$(conf_get "$f" name | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]')" ]; then
      basename "$f" .app.conf; return 0
    fi
  done
  return 1
}

cmd_apps() {
  local f any=0
  if [ "${1:-}" = "--plain" ]; then
    # For Burrow.app: "id<TAB>name<TAB>bottle<TAB>steam-appid" per line.
    for f in "$LIBRARY"/*.app.conf; do
      [ -f "$f" ] && printf '%s\t%s\t%s\t%s\n' "$(basename "$f" .app.conf)" "$(conf_get "$f" name)" \
        "$(conf_get "$f" bottle)" "$(conf_get "$f" steam_appid 2>/dev/null)"
    done
    return 0
  fi
  for f in "$LIBRARY"/*.app.conf; do
    [ -f "$f" ] || continue; any=1
    printf '%-28s %s(%s)%s\n' "$(conf_get "$f" name)" "$D" "$(conf_get "$f" bottle)" "$N"
  done
  [ "$any" = 1 ] || say "Your library is empty. Install something with: burrow install <setup.exe>"
  return 0
}

# Lists Start Menu and Desktop shortcuts in a bottle, one path per line.
list_shortcuts() { # prefix
  find "$1/drive_c/ProgramData/Microsoft/Windows/Start Menu" \
       "$1/drive_c/users" \
       -iname '*.lnk' 2>/dev/null | grep -v '/AppData/Roaming/Microsoft/Internet Explorer/' | sort
}

# Unix path in a bottle -> C:\ path.
win_path() { # prefix unix-path
  local rel="${2#"$1"/drive_c/}"
  printf 'C:\\%s' "$(printf '%s' "$rel" | tr '/' '\\')"
}

cmd_install() { # installer [--bottle B] [--name N] [--preset P]
  local installer="" bottle="" name="" preset=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --bottle) bottle="${2:-}"; shift 2 ;;
      --name) name="${2:-}"; shift 2 ;;
      --preset) preset="${2:-}"; shift 2 ;;
      *) installer="$1"; shift ;;
    esac
  done
  [ -n "$installer" ] || die "usage: burrow install <setup.exe or .msi> [--bottle NAME] [--name NAME] [--preset PRESET]"
  case "$installer" in
    http://*|https://*)
      local fname; fname=$(basename "${installer%%\?*}"); [ -n "$fname" ] || fname=setup.exe
      download "$installer" "$CACHE/downloads/$fname" || die "couldn't download $installer"
      installer="$CACHE/downloads/$fname" ;;
  esac
  [ -f "$installer" ] || die "no such file: $installer"
  local base; base=$(basename "$installer"); base="${base%.*}"
  [ -n "$bottle" ] || bottle="${name:-$base}"
  if ! bottle_exists "$bottle"; then cmd_bottle_create "$bottle" "$preset"
  elif [ -n "$preset" ]; then cmd_bottle_create "$bottle" "$preset"; fi
  use_bottle "$bottle"

  local before after log; before="$CACHE/lnk-before.$$"; after="$CACHE/lnk-after.$$"
  list_shortcuts "$WINEPREFIX" > "$before"
  log=$(new_log "install-$base")
  step "Running $(basename "$installer") in bottle '$bottle'. Finish the installer's windows; Burrow waits."
  case "$installer" in
    *.msi|*.MSI) "$WINE" msiexec /i "$installer" >"$log" 2>&1 ;;
    *) (cd "$(dirname "$installer")" && "$WINE" "$installer" >"$log" 2>&1) ;;
  esac
  "$WINESERVER" -w 2>/dev/null
  list_shortcuts "$WINEPREFIX" > "$after"

  local added=0 lnk n id
  while IFS= read -r lnk; do
    [ -n "$lnk" ] || continue
    n=$(basename "$lnk" .lnk)
    case "$(printf '%s' "$n" | tr '[:upper:]' '[:lower:]')" in
      *uninstall*|*readme*|*"read me"*|*help*|*manual*|*website*|*license*) continue ;;
    esac
    id=$(lib_add "$n" "$bottle" "$(win_path "$WINEPREFIX" "$lnk")")
    ok "Added to your library: $n"
    added=$((added + 1))
  done < <(comm -13 "$before" "$after")
  rm -f "$before" "$after"
  if [ "$added" = 0 ]; then
    warn "The installer made no shortcuts. Add the program yourself:"
    warn "  burrow add \"Name\" --bottle '$bottle' --exe 'C:\\Path\\To\\Program.exe'"
  fi
  return 0
}

cmd_add() { # name --bottle B --exe PATH [--args A]
  local name="${1:-}" bottle="" exe="" args=""
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --bottle) bottle="${2:-}"; shift 2 ;;
      --exe) exe="${2:-}"; shift 2 ;;
      --args) args="${2:-}"; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  [ -n "$name" ] && [ -n "$bottle" ] && [ -n "$exe" ] || die "usage: burrow add NAME --bottle BOTTLE --exe 'C:\\...\\program.exe' [--args '...']"
  bottle_exists "$bottle" || die "no bottle named '$bottle'"
  # A Mac path: inside the bottle it becomes C:\…; anywhere else Wine reaches it through Z:.
  case "$exe" in
    /*)
      [ -f "$exe" ] || die "no such file: $exe"
      local prefix; prefix=$(bottle_prefix "$bottle")
      case "$exe" in
        "$prefix"/drive_c/*) exe=$(win_path "$prefix" "$exe") ;;
        *) exe="Z:$(printf '%s' "$exe" | tr '/' '\\')" ;;
      esac ;;
  esac
  lib_add "$name" "$bottle" "$exe" "$args" >/dev/null
  ok "Added $name"
}

cmd_remove() {
  local id name; id=$(lib_find "${1:-}") || die "no app called '${1:-}' (see: burrow apps)"
  name=$(conf_get "$(lib_file "$id")" name)
  rm -f "$(lib_file "$id")"
  [ -n "$name" ] && rm -rf "$SHORTCUTS/$(printf '%s' "$name" | tr '/:' '--').app"
  ok "Removed $1 from the library (it's still installed in its bottle)"
}

cmd_launch() { # app [--graphics G] [-- extra args]
  local q="${1:-}"; shift || true
  local graphics="" extra=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --graphics) graphics="${2:-}"; shift 2 ;;
      --) shift; extra="$*"; break ;;
      *) extra="$extra $1"; shift ;;
    esac
  done
  local id f; id=$(lib_find "$q") || die "no app called '$q' (see: burrow apps)"
  f=$(lib_file "$id")
  local name bottle target args
  name=$(conf_get "$f" name); bottle=$(conf_get "$f" bottle); target=$(conf_get "$f" target)
  args=$(conf_get "$f" args)
  if [ "$bottle" = "$STEAM_BOTTLE" ] && [ "$(conf_get "$f" steam_appid 2>/dev/null)" != "" ]; then
    cmd_steam_play "$(conf_get "$f" steam_appid)"; return
  fi
  use_bottle "$bottle" "$graphics" "$id"
  local log; log=$(new_log "$name")
  { echo "burrow $BURROW_VERSION launch '$name' on $BOTTLE_ENGINE"; env | grep -E '^(WINE|DYLD|GST|MTL|MVK)'
    local v; for v in $BURROW_USER_ENV; do printf '%s=%s\n' "$v" "$(printenv "$v")"; done; } > "$log"
  step "Starting $name ($BOTTLE_ENGINE)…  log: $log"
  # `start /wait` follows .lnk shortcuts and sets the program's own folder as the working dir.
  # shellcheck disable=SC2086
  "$WINE" start /wait "$target" $args $extra >>"$log" 2>&1 &
  [ "${BURROW_FOREGROUND:-0}" = 1 ] && wait
  return 0
}

cmd_run() { # bottle exe [args...]
  local bottle="${1:-}"; shift || true
  [ $# -gt 0 ] || die "usage: burrow run <bottle> <program.exe> [args]"
  bottle_exists "$bottle" || cmd_bottle_create "$bottle"
  use_bottle "$bottle"
  "$WINE" "$@"
}

# --- Steam ----------------------------------------------------------------------------------------
steam_root() { printf '%s/%s' "$(bottle_prefix "$STEAM_BOTTLE")" "$STEAM_REL"; }

# Puts Burrow's wrapper in front of every steamwebhelper.exe. Steam replaces the file when it
# updates, so this runs before each launch and keeps watching while Steam is open.
wrap_webhelpers() { # quiet?
  local root wrapper f dir changed=0
  root=$(steam_root); wrapper="$APPDIR/wrapper/steamwebhelper.exe"
  [ -f "$wrapper" ] || die "missing $wrapper (re-download Burrow)"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    grep -aq "$WRAPPER_MARKER" "$f" 2>/dev/null && continue
    dir=$(dirname "$f")
    mv -f "$f" "$dir/steamwebhelper_real.exe" && cp "$wrapper" "$f" && changed=1
  done < <(find "$root/bin/cef" -name steamwebhelper.exe 2>/dev/null)
  [ "$changed" = 1 ] && [ -z "${1:-}" ] && ok "Applied the Steam window fix"
  return 0
}

watch_webhelpers() { # runs in the background until the bottle's wineserver exits
  local done_flag="$1"
  while [ ! -f "$done_flag" ]; do wrap_webhelpers quiet; sleep 2; done
  rm -f "$done_flag"
}

cmd_steam_install() {
  bottle_exists "$STEAM_BOTTLE" || cmd_bottle_create "$STEAM_BOTTLE" gaming
  use_bottle "$STEAM_BOTTLE"
  if [ -f "$(steam_root)/steam.exe" ] || [ -f "$(steam_root)/Steam.exe" ]; then ok "Windows Steam is installed"; return 0; fi
  local setup="$CACHE/SteamSetup.exe"
  step "Downloading Steam's Windows installer from Valve…"
  download "$STEAM_SETUP_URL" "$setup" || die "couldn't download SteamSetup.exe"
  step "Installing Windows Steam…"
  "$WINE" "$setup" /S >"$(new_log steam-install)" 2>&1
  "$WINESERVER" -w 2>/dev/null
  [ -f "$(steam_root)/steam.exe" ] || [ -f "$(steam_root)/Steam.exe" ] || die "Steam didn't install; see the log in $LOGS"
  # Steam adds itself to Windows startup; Wine would then start it without our fixes.
  "$WINE" reg delete 'HKCU\Software\Microsoft\Windows\CurrentVersion\Run' /v Steam /f >/dev/null 2>&1
  "$WINESERVER" -w 2>/dev/null
  ok "Windows Steam installed"
}

steam_exe_win() { if [ -f "$(steam_root)/Steam.exe" ]; then printf '%s\\Steam.exe' "$STEAM_DIR_WIN"; else printf '%s\\steam.exe' "$STEAM_DIR_WIN"; fi; }

steam_running() { [ -f "$BOTTLES/$STEAM_BOTTLE/.steam-running" ] && kill -0 "$(cat "$BOTTLES/$STEAM_BOTTLE/.steam-running")" 2>/dev/null; }

cmd_steam_open() { # [extra steam args]
  cmd_steam_install
  use_bottle "$STEAM_BOTTLE" "${BURROW_STEAM_GRAPHICS:-auto}"
  if steam_running; then
    # Hand the request to the running Steam (it forwards -applaunch etc. to itself).
    "$WINE" "$(steam_exe_win)" "$@" >/dev/null 2>&1 &
    return 0
  fi
  [ "$BOTTLE_ENGINE" = "$TURBO_ENGINE" ] || warn "Turbo graphics isn't built, so 3D games will be slow or fail. Run: burrow turbo"
  wrap_webhelpers
  local log flag; log=$(new_log steam); flag="$BOTTLES/$STEAM_BOTTLE/.steam-closed"
  rm -f "$flag"
  step "Opening Windows Steam ($BOTTLE_ENGINE). The first start updates Steam; if it closes, run burrow steam again."
  (
    watch_webhelpers "$flag" &
    # -no-cef-sandbox: Chromium's sandbox doesn't work under Wine.
    "$WINE" "$(steam_exe_win)" -no-cef-sandbox "$@" >"$log" 2>&1
    "$WINESERVER" -w 2>/dev/null
    : > "$flag"
    rm -f "$BOTTLES/$STEAM_BOTTLE/.steam-running"
  ) &
  echo $! > "$BOTTLES/$STEAM_BOTTLE/.steam-running"
  [ "${BURROW_FOREGROUND:-0}" = 1 ] && wait
  return 0
}

# Prints "appid<TAB>name<TAB>installdir" for each installed Steam game.
steam_games() {
  local root f lib libs
  root=$(steam_root)
  libs=$(cd -P "$root/steamapps" 2>/dev/null && pwd) || return 0
  # Extra library folders: "path" "C:\\Games\\SteamLibrary" in libraryfolders.vdf.
  if [ -f "$root/steamapps/libraryfolders.vdf" ]; then
    while IFS= read -r lib; do
      lib=$(printf '%s' "$lib" | sed 's/\\\\/\\/g')
      case "$lib" in [A-Za-z]:\\*) ;; *) continue ;; esac
      local drive; drive=$(printf '%s' "${lib%%:*}" | tr '[:upper:]' '[:lower:]')
      local rest; rest=$(printf '%s' "${lib#?:\\}" | tr '\\' '/')
      local unix real
      unix="$(bottle_prefix "$STEAM_BOTTLE")/dosdevices/$drive:/$rest/steamapps"
      real=$(cd -P "$unix" 2>/dev/null && pwd) || continue
      # Library 0 is Steam's own folder, reached here through dosdevices/c:.
      printf '%s\n' "$libs" | grep -qxF "$real" || libs="$libs
$real"
    done < <(sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$root/steamapps/libraryfolders.vdf")
  fi
  printf '%s\n' "$libs" | while IFS= read -r lib; do
    for f in "$lib"/appmanifest_*.acf; do
      [ -f "$f" ] || continue
      local id name dir
      id=$(sed -n 's/^[[:space:]]*"appid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$f" | head -1)
      name=$(sed -n 's/^[[:space:]]*"name"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$f" | head -1)
      dir=$(sed -n 's/^[[:space:]]*"installdir"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$f" | head -1)
      # Skip Steam's own runtimes (Steamworks redistributables, Proton, etc.).
      case "$id" in 228980|1070560|1391110|1628350) continue ;; esac
      [ -n "$id" ] && printf '%s\t%s\t%s\n' "$id" "$name" "$dir"
    done
  done
}

cmd_steam_games() {
  if [ "${1:-}" = "--plain" ]; then
    bottle_exists "$STEAM_BOTTLE" && steam_games | cut -f1,2
    return 0
  fi
  bottle_exists "$STEAM_BOTTLE" || die "Steam isn't installed yet; run: burrow steam"
  local out; out=$(steam_games)
  [ -n "$out" ] || { say "No Steam games installed yet. Install them in Steam, then run this again."; return 0; }
  printf '%s\n' "$out" | while IFS="$(printf '\t')" read -r id name dir; do
    printf '%-10s %s\n' "$id" "$name"
  done
}

# Adds every installed Steam game to the library so it shows in the app menu and can get a
# Mac shortcut.
cmd_steam_sync() {
  local out added=0; out=$(steam_games)
  [ -n "$out" ] || { say "No Steam games installed yet."; return 0; }
  while IFS="$(printf '\t')" read -r id name dir; do
    [ -n "$id" ] || continue
    grep -qxF "steam_appid=$id" "$LIBRARY"/*.app.conf 2>/dev/null && continue
    local lid; lid=$(lib_add "$name" "$STEAM_BOTTLE" "steam://rungameid/$id")
    conf_set "$(lib_file "$lid")" steam_appid "$id"
    ok "Added $name"; added=$((added + 1))
  done < <(printf '%s\n' "$out")
  [ "$added" -gt 0 ] || say "Your Steam games are already in the library."
}

cmd_steam_play() { # appid or name
  local q="${1:-}" id=""
  [ -n "$q" ] || die "usage: burrow steam play <appid or game name>"
  case "$q" in *[!0-9]*) ;; *) id="$q" ;; esac
  if [ -z "$id" ]; then
    id=$(steam_games | awk -F '\t' -v q="$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]')" 'tolower($2)==q {print $1; exit}')
    [ -n "$id" ] || id=$(steam_games | awk -F '\t' -v q="$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]')" 'index(tolower($2),q) {print $1; exit}')
    [ -n "$id" ] || die "no installed Steam game matches '$q' (see: burrow steam games)"
  fi
  cmd_steam_open -applaunch "$id"
}

cmd_steam() {
  local sub="${1:-open}"; shift || true
  case "$sub" in
    open|start) cmd_steam_open "$@" ;;
    install) cmd_steam_install ;;
    games) cmd_steam_games "$@" ;;
    sync) cmd_steam_sync ;;
    play|launch) cmd_steam_play "$@" ;;
    fix) cmd_steam_install; wrap_webhelpers ;;
    *) die "unknown: burrow steam $sub (open, games, play, sync, fix)" ;;
  esac
}

# --- Mac shortcuts ------------------------------------------------------------------------------
# Each shortcut is a tiny AppleScript app made on this Mac with osacompile. Apps made locally
# carry no quarantine flag, so Gatekeeper doesn't stop them.
applescript_quote() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
shell_quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

cmd_shortcut() { # app
  is_mac || die "shortcuts are Mac apps; run this on the Mac"
  local id f name; id=$(lib_find "${1:-}") || die "no app called '${1:-}' (see: burrow apps)"
  f=$(lib_file "$id"); name=$(conf_get "$f" name)
  mkdir -p "$SHORTCUTS"
  local cmd; cmd="$(shell_quote "$APPDIR/bin/burrow") launch $(shell_quote "$id") >/dev/null 2>&1 &"
  local app; app="$SHORTCUTS/$(printf '%s' "$name" | tr '/:' '--').app"
  rm -rf "$app"
  /usr/bin/osacompile -o "$app" -e "do shell script \"$(applescript_quote "$cmd")\"" || die "couldn't make the shortcut"
  ok "Made $app (drag it to your Dock)"
}

cmd_app() { # builds Burrow.app: the windowed app, or the simple menu if Swift isn't available
  is_mac || die "Burrow.app is made on the Mac"
  local dest="${1:-$HOME/Applications/Burrow.app}"
  mkdir -p "$(dirname "$dest")"
  if [ "${BURROW_MENU_APP:-0}" != 1 ] && build_window_app "$dest"; then
    ok "Made $dest"
    return 0
  fi
  build_menu_app "$dest"
}

# The windowed app (app/BurrowApp.swift), compiled with the Command Line Tools' swiftc.
build_window_app() { # dest
  local dest="$1" src="$APPDIR/app/BurrowApp.swift"
  [ -f "$src" ] || return 1
  if ! xcode-select -p >/dev/null 2>&1 || ! xcrun --find swiftc >/dev/null 2>&1; then
    warn "Apple's Command Line Tools aren't installed, so Burrow gets its simple menu for now."
    warn "Install them (xcode-select --install), then run: burrow app"
    return 1
  fi
  local major; major=$(sw_vers -productVersion | cut -d. -f1)
  if [ "$major" -lt 13 ]; then warn "the Burrow window needs macOS 13 or newer; using the simple menu"; return 1; fi
  step "Building the Burrow window app…"
  local tmp; tmp=$(mktemp -d -t burrow-app) || return 1
  local log="$LOGS/app-build.log"
  # Through xcrun so swiftc is told where the macOS SDK is; run bare it can't find it.
  if ! xcrun --sdk macosx swiftc -O -swift-version 5 -parse-as-library -target "$(uname -m)-apple-macos13.0" \
        "$src" -o "$tmp/Burrow" > "$log" 2>&1; then
    warn "The window app didn't compile (details in $log); using the simple menu."
    rm -rf "$tmp"
    return 1
  fi
  local app="$tmp/Burrow.app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  mv "$tmp/Burrow" "$app/Contents/MacOS/Burrow"
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Burrow</string>
  <key>CFBundleDisplayName</key><string>Burrow</string>
  <key>CFBundleIdentifier</key><string>com.swollzy.burrow</string>
  <key>CFBundleExecutable</key><string>Burrow</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$BURROW_VERSION</string>
  <key>CFBundleVersion</key><string>$BURROW_VERSION</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.games</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSAppleEventsUsageDescription</key><string>Burrow opens Terminal to install Homebrew.</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>Windows Program</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>CFBundleTypeExtensions</key><array><string>exe</string><string>msi</string></array>
    </dict>
  </array>
</dict>
</plist>
PLIST
  # Ad-hoc signature so Apple Silicon runs it; made on this Mac, so no quarantine.
  codesign --force --deep -s - "$app" >/dev/null 2>&1 || true
  rm -rf "$dest"
  mv "$app" "$dest"
  rm -rf "$tmp"
  return 0
}

# The simple menu (app/Burrow.applescript), made with osacompile; works without developer tools.
build_menu_app() { # dest
  local src="$APPDIR/app/Burrow.applescript" dest="$1"
  [ -f "$src" ] || die "missing $src"
  local tmp; tmp=$(mktemp -t burrow) || die "couldn't make a temp file"
  sed "s|__BURROW_CLI__|$(applescript_quote "$APPDIR/bin/burrow" | sed 's/[|&]/\\&/g')|" "$src" > "$tmp"
  rm -rf "$dest"
  /usr/bin/osacompile -l AppleScript -o "$dest" "$tmp" || { rm -f "$tmp"; die "couldn't build Burrow.app"; }
  rm -f "$tmp"
  ok "Made $dest (simple menu)"
}

# --- Housekeeping ----------------------------------------------------------------------------------
cmd_doctor() {
  step "Burrow $BURROW_VERSION doctor"
  if is_mac; then
    say "macOS $(sw_vers -productVersion) on $(uname -m)"
    if [ "$(uname -m)" = arm64 ]; then
      /usr/bin/arch -x86_64 /usr/bin/true 2>/dev/null && ok "Rosetta 2" || warn "Rosetta 2 missing (burrow setup installs it)"
    fi
    [ -d /Library/Frameworks/GStreamer.framework ] && ok "GStreamer (in-game video)" || warn "GStreamer missing: game intro videos may be black"
  fi
  engine_ok "$STOCK_ENGINE" && ok "Wine $WINE_VERSION" || warn "Wine missing: burrow setup"
  [ -d "$RUNTIMES/dxmt-$DXMT_VERSION/x86_64-windows" ] && ok "DXMT $DXMT_VERSION downloaded" || warn "DXMT missing: burrow setup"
  engine_ok "$TURBO_ENGINE" && ok "Turbo graphics built" || warn "Turbo graphics not built: burrow turbo"
  if bottle_exists "$STEAM_BOTTLE"; then
    [ -f "$(steam_root)/steam.exe" ] || [ -f "$(steam_root)/Steam.exe" ] && ok "Windows Steam installed" || warn "Steam bottle exists but Steam isn't installed: burrow steam install"
    local unwrapped; unwrapped=$(find "$(steam_root)/bin/cef" -name steamwebhelper.exe 2>/dev/null | while IFS= read -r f; do grep -aq "$WRAPPER_MARKER" "$f" || echo "$f"; done)
    [ -z "$unwrapped" ] && ok "Steam window fix in place" || warn "Steam window fix not applied yet (applied on next burrow steam)"
  fi
  local free; free=$(df -Pk "$HOME" 2>/dev/null | awk 'NR==2 {print int($4/1048576)}')
  [ -n "$free" ] && { [ "$free" -ge 20 ] && ok "${free} GB free" || warn "only ${free} GB free; games and Wine need room"; }
  return 0
}

# --- Usage: disk space and memory ------------------------------------------------------------
kb_size() { du -sk "$1" 2>/dev/null | awk '{print $1+0}'; }
human_kb() { awk -v k="${1:-0}" 'BEGIN { if (k >= 1048576) printf "%.1f GB", k/1048576; else if (k >= 1024) printf "%.0f MB", k/1024; else printf "%d KB", k }'; }

# The environment of a running process, one VAR=value per line (best effort).
proc_env() { # pid
  if [ -r "/proc/$1/environ" ]; then { tr '\000' '\n' < "/proc/$1/environ"; } 2>/dev/null
  else ps -E -ww -p "$1" -o command= 2>/dev/null; fi
}

# Prints "bottle<TAB>name<TAB>pid<TAB>rss-kb" for every running process started in a bottle.
running_procs() {
  local bottles=() d
  for d in "$BOTTLES"/*/; do [ -d "$d/prefix" ] && bottles+=("$(basename "$d")"); done
  [ ${#bottles[@]} -gt 0 ] || return 0
  ps -axww -o pid= -o rss= -o command= 2>/dev/null | while read -r pid rss cmd; do
    [ "$pid" = "$$" ] && continue
    case "$cmd" in *wine*|*.exe*|*.EXE*) ;; *) continue ;; esac
    local env b found="" name
    env=$(proc_env "$pid") || continue
    for b in "${bottles[@]}"; do
      case "$env" in *"WINEPREFIX=$BOTTLES/$b/prefix"*) found="$b"; break ;; esac
    done
    [ -n "$found" ] || continue
    name=$(printf '%s' "$cmd" | grep -oiE '[^\\/]+\.exe' | head -1)
    [ -n "$name" ] || name=$(basename "${cmd%% *}")
    case "$name" in wineserver*) name="Wine (system)" ;; esac
    printf '%s\t%s\t%s\t%s\n' "$found" "$name" "$pid" "${rss:-0}"
  done
}

cmd_usage() { # [--plain] [--ram]
  local plain=0 ramonly=0 a
  for a in "$@"; do case "$a" in --plain) plain=1 ;; --ram) ramonly=1 ;; esac; done
  local procs; procs=$(running_procs)
  if [ "$ramonly" = 0 ]; then
    local rows="" d n k total=0
    for d in "$BOTTLES"/*/; do
      [ -d "$d" ] || continue
      n=$(basename "$d"); k=$(kb_size "$d"); total=$((total + k))
      rows="$rows$(printf 'bottle\t%s\t%s' "$n" "$k")
"
    done
    # Steam games, inside the Steam bottle (already counted in its total).
    local games=""
    if bottle_exists "$STEAM_BOTTLE"; then
      local id name dir common
      common="$(steam_root)/steamapps/common"
      while IFS="$(printf '\t')" read -r id name dir; do
        [ -n "$id" ] && [ -d "$common/$dir" ] || continue
        games="$games$(printf 'game\t%s\t%s' "$name" "$(kb_size "$common/$dir")")
"
      done < <(steam_games)
    fi
    k=$(kb_size "$ENGINES"); total=$((total + k)); rows="$rows$(printf 'engine\tWine engines\t%s' "$k")
"
    if [ -d "$SNAPSHOTS" ]; then
      # On APFS snapshots share space with their bottles, so this overstates what they cost.
      k=$(kb_size "$SNAPSHOTS"); total=$((total + k)); rows="$rows$(printf 'snapshot\tSnapshots\t%s' "$k")
"
    fi
    k=$(( $(kb_size "$RUNTIMES") + $(kb_size "$CACHE") + $(kb_size "$LOGS") )); total=$((total + k))
    rows="$rows$(printf 'other\tDownloads, cache and logs\t%s' "$k")
"
    local free; free=$(df -Pk "$BURROW_HOME" 2>/dev/null | awk 'NR==2 {print $4+0}')
    if [ "$plain" = 1 ]; then
      printf '%s%s' "$rows" "$games" | sed '/^$/d' | sed 's/^/DISK\t/'
      printf 'TOTAL\t%s\nFREE\t%s\n' "$total" "${free:-0}"
    else
      say "${B}Disk space used by Burrow${N}  ($BURROW_HOME)"
      printf '%s' "$rows" | while IFS="$(printf '\t')" read -r kind n k; do
        [ -n "$kind" ] || continue
        case "$kind" in bottle) n="Bottle: $n" ;; esac
        printf '  %-40s %10s\n' "$n" "$(human_kb "$k")"
      done
      if [ -n "$games" ]; then
        say "  ${D}Steam games (inside the Steam bottle):${N}"
        printf '%s' "$games" | while IFS="$(printf '\t')" read -r kind n k; do
          [ -n "$kind" ] && printf '    %-38s %10s\n' "$n" "$(human_kb "$k")"
        done
      fi
      printf '  %-40s %10s\n' "${B}Total${N}" "$(human_kb "$total")"
      printf '  %-40s %10s\n' "Free on this disk" "$(human_kb "${free:-0}")"
      say ""
    fi
  fi
  if [ "$plain" = 1 ]; then
    printf '%s\n' "$procs" | sed '/^$/d' | sed 's/^/PROC\t/'
    return 0
  fi
  say "${B}Memory (RAM) used by running Windows programs${N}"
  if [ -z "$procs" ]; then say "  Nothing is running."; return 0; fi
  printf '%s\n' "$procs" | sort -t "$(printf '\t')" -k4,4nr | while IFS="$(printf '\t')" read -r b n pid k; do
    printf '  %-28s %-12s %10s\n' "$n" "($b)" "$(human_kb "$k")"
  done
  local sum; sum=$(printf '%s\n' "$procs" | awk -F '\t' '{s += $4} END {print s+0}')
  printf '  %-41s %10s\n' "${B}Total${N}" "$(human_kb "$sum")"
}

# Asks macOS to install Apple's Command Line Tools (needed for turbo and the window app).
cmd_tools() {
  is_mac || die "this is for the Mac"
  if xcode-select -p >/dev/null 2>&1; then ok "Apple's Command Line Tools are installed"; return 0; fi
  xcode-select --install 2>/dev/null || true
  say "Click Install in the window that opened. When it finishes, come back and continue."
}

# One line of flags for Burrow.app: "setup=1 turbo=0 steam=1 clt=1 brew=0 gst=0 mac=1 arm=1".
cmd_status() {
  local s=0 t=0 st=0 clt=0 brew=0 gst=0 mac=0 arm=0
  { [ -n "${BURROW_WINE:-}" ] || engine_ok "$STOCK_ENGINE"; } && [ -d "$RUNTIMES/dxmt-$DXMT_VERSION/x86_64-windows" ] && s=1
  engine_ok "$TURBO_ENGINE" && t=1
  { [ -f "$(steam_root)/steam.exe" ] || [ -f "$(steam_root)/Steam.exe" ]; } && st=1
  is_mac && mac=1
  [ "$(uname -m)" = arm64 ] && arm=1
  is_mac && xcode-select -p >/dev/null 2>&1 && clt=1
  { [ -x /opt/homebrew/bin/brew ] || [ -x /usr/local/bin/brew ]; } && brew=1
  [ -d /Library/Frameworks/GStreamer.framework ] && gst=1
  printf 'setup=%s turbo=%s steam=%s clt=%s brew=%s gst=%s mac=%s arm=%s\n' "$s" "$t" "$st" "$clt" "$brew" "$gst" "$mac" "$arm"
}

cmd_kill() { # [bottle] stops every program in a bottle (or all bottles)
  local d
  if [ -n "${1:-}" ]; then bottle_exists "$1" || die "no bottle named '$1'"; stop_bottle "$1"; ok "Stopped everything in '$1'"; return; fi
  for d in "$BOTTLES"/*/; do
    [ -d "$d/prefix" ] || continue
    stop_bottle "$(basename "$d")"
  done
  ok "Stopped all Windows programs"
}

cmd_winecfg() { local b="${1:-$STEAM_BOTTLE}"; bottle_exists "$b" || die "no bottle named '$b'"; use_bottle "$b"; "$WINE" winecfg; }

usage() {
  cat <<EOF
${B}Burrow $BURROW_VERSION${N}: Windows programs and Windows Steam on your Mac.

  ${B}burrow setup${N}                     download Wine and DXMT (once)
  ${B}burrow turbo${N}                     build fast Metal graphics for 3D games (once)
  ${B}burrow steam${N}                     install (first time) and open Windows Steam
  burrow steam games               list installed Steam games
  burrow steam play "Schedule I"   start a Steam game
  burrow steam sync                put your Steam games in the library
  ${B}burrow install${N} <setup.exe|url>   install a Windows program into its own bottle
                                   (--bottle NAME, --preset gaming|apps|legacy|retro|desktop)
  burrow apps                      list your library
  burrow launch <app>              start a program (--graphics turbo|compat)
  burrow shortcut <app>            make a Mac app for it in ~/Applications/Burrow
  burrow add NAME --bottle B --exe 'C:\\path\\app.exe'
  burrow remove <app>
  burrow bottle new NAME [--preset P]   a new Windows install (also: list, clone, delete)
  ${B}burrow desktop${N} <bottle> [WxH]       open a bottle as a whole Windows desktop in one window
  ${B}burrow settings${N} <bottle> [key value] compatibility settings (--app <app> for one program)
  burrow settings --list           what every setting does
  burrow presets                   ready-made settings for games, apps, old games…
  burrow snapshot save|list|restore|delete <bottle>   save a bottle and roll back to it
  burrow components <bottle> [install vcrun2022 …]    Visual C++, .NET, fonts (winetricks)
  burrow run <bottle> <program.exe> [args]
  burrow winecfg [bottle]          Wine's settings window
  burrow kill [bottle]             force-quit Windows programs
  burrow usage                     disk space per bottle and game, and RAM of running programs
  burrow usage --ram               just the memory of running programs
  burrow doctor                    check everything
  burrow app                       (re)build Burrow.app, the window app

Files live in: $BURROW_HOME
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  mkdir -p "$ENGINES" "$RUNTIMES" "$BOTTLES" "$LIBRARY" "$LOGS" "$CACHE" "$SNAPSHOTS" 2>/dev/null
  case "$cmd" in
    setup) cmd_setup ;;
    turbo) cmd_turbo "$@" ;;
    steam) cmd_steam "$@" ;;
    install) cmd_install "$@" ;;
    add) cmd_add "$@" ;;
    apps|library|list) cmd_apps "$@" ;;
    status) cmd_status ;;
    usage|du|memory|top) cmd_usage "$@" ;;
    tools) cmd_tools ;;
    launch|open|play) cmd_launch "$@" ;;
    remove|rm) cmd_remove "$@" ;;
    shortcut) cmd_shortcut "$@" ;;
    bottle|bottles) cmd_bottle "$@" ;;
    settings|config|set) cmd_settings "$@" ;;
    presets) cmd_presets "$@" ;;
    snapshot|snapshots|snap) cmd_snapshot "$@" ;;
    desktop) cmd_desktop "$@" ;;
    components|component|winetricks) cmd_components "$@" ;;
    run) cmd_run "$@" ;;
    winecfg|wine-settings) cmd_winecfg "$@" ;;
    kill|stop) cmd_kill "$@" ;;
    doctor) cmd_doctor ;;
    app) cmd_app "$@" ;;
    version|--version|-v) say "burrow $BURROW_VERSION" ;;
    help|--help|-h) usage ;;
    *) usage; die "unknown command: $cmd" ;;
  esac
}

main "$@"
